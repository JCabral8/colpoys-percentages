{
 "lines": [
  {
   "i": 0,
   "speaker": "hayes",
   "text": "Mitch Marner. First year in Vegas... points.",
   "start": 0.0,
   "end": 3.92
  },
  {
   "i": 1,
   "speaker": "odog",
   "text": "Out of Toronto, on a line with Eye-kel, NO pressure. Everybody in this room had him going nuts.",
   "start": 3.92,
   "end": 11.919
  },
  {
   "i": 2,
   "speaker": "hayes",
   "text": "Jay, one oh one. Chris, one hundred. Nick, ninety-five. Justin... ninety-two.",
   "start": 11.919,
   "end": 18.479,
   "hl": [
    "jay",
    "chris",
    "nick",
    "justin"
   ]
  },
  {
   "i": 3,
   "speaker": "odog",
   "text": "Four guys, ALL of them over ninety. Not one of them under. That tells you something.",
   "start": 18.479,
   "end": 24.64
  },
  {
   "i": 4,
   "speaker": "hayes",
   "text": "The actual... eighty. Twenty-four goals, fifty-six assists, eighty-one games.",
   "start": 24.64,
   "end": 32.479,
   "reveal": true
  },
  {
   "i": 5,
   "speaker": "odog",
   "text": "Eighty. He didn't get WORSE, boys. He just stopped playing with Matthews. It's a moot point how good he is... the number was never gonna be a hundred.",
   "start": 32.479,
   "end": 42.72
  },
  {
   "i": 6,
   "speaker": "hayes",
   "text": "Closest is Justin at ninety-two. Justin takes the W. Jay... twenty-one off, worst in the room. L.",
   "start": 42.72,
   "end": 52.24,
   "final": true
  }
